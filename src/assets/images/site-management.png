<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="500" height="300" viewBox="0 0 500 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="500" height="300" fill="#f1f5f9"/>
  <rect x="20" y="20" width="460" height="260" rx="10" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Site management header -->
  <rect x="30" y="30" width="150" height="20" rx="5" fill="#2563eb"/>
  
  <!-- Sites grid -->
  <rect x="40" y="70" width="100" height="100" rx="8" fill="#dbeafe"/>
  <rect x="150" y="70" width="100" height="100" rx="8" fill="#dbeafe"/>
  <rect x="260" y="70" width="100" height="100" rx="8" fill="#dbeafe"/>
  <rect x="370" y="70" width="100" height="100" rx="8" fill="#dbeafe"/>
  
  <!-- Site details -->
  <rect x="40" y="180" width="420" height="80" rx="8" fill="#f8fafc"/>
  <rect x="50" y="190" width="100" height="10" rx="4" fill="#2563eb"/>
  <rect x="50" y="205" width="200" height="10" rx="4" fill="#8b5cf6"/>
  
  <!-- Icons -->
  <circle cx="80" cy="100" r="15" fill="#2563eb"/>
  <circle cx="190" cy="100" r="15" fill="#8b5cf6"/>
  <circle cx="300" cy="100" r="15" fill="#10b981"/>
  <circle cx="410" cy="100" r="15" fill="#f59e0b"/>
</svg>