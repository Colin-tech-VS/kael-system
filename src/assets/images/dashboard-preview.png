<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="500" height="300" viewBox="0 0 500 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="500" height="300" fill="#f1f5f9"/>
  <rect x="20" y="20" width="460" height="260" rx="10" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Dashboard header -->
  <rect x="30" y="30" width="100" height="20" rx="5" fill="#2563eb"/>
  <rect x="140" y="30" width="150" height="20" rx="5" fill="#8b5cf6"/>
  
  <!-- Cards -->
  <rect x="40" y="70" width="120" height="80" rx="8" fill="#dbeafe"/>
  <rect x="170" y="70" width="120" height="80" rx="8" fill="#dbeafe"/>
  <rect x="300" y="70" width="120" height="80" rx="8" fill="#dbeafe"/>
  
  <!-- Chart area -->
  <rect x="40" y="170" width="420" height="100" rx="8" fill="#f8fafc"/>
  <rect x="50" y="180" width="400" height="20" rx="4" fill="#2563eb"/>
  <rect x="50" y="205" width="400" height="20" rx="4" fill="#8b5cf6"/>
  
  <!-- Status indicators -->
  <circle cx="100" cy="100" r="6" fill="#10b981"/>
  <circle cx="230" cy="100" r="6" fill="#f59e0b"/>
  <circle cx="360" cy="100" r="6" fill="#ef4444"/>
</svg>