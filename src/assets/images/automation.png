<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="500" height="300" viewBox="0 0 500 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="500" height="300" fill="#f1f5f9"/>
  <rect x="20" y="20" width="460" height="260" rx="10" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Automation header -->
  <rect x="30" y="30" width="150" height="20" rx="5" fill="#2563eb"/>
  
  <!-- Workflow diagram -->
  <rect x="40" y="70" width="100" height="60" rx="8" fill="#dbeafe"/>
  <rect x="160" y="70" width="100" height="60" rx="8" fill="#dbeafe"/>
  <rect x="280" y="70" width="100" height="60" rx="8" fill="#dbeafe"/>
  <rect x="400" y="70" width="100" height="60" rx="8" fill="#dbeafe"/>
  
  <!-- Arrows -->
  <line x1="140" y1="100" x2="160" y2="100" stroke="#2563eb" stroke-width="2" marker-end="url(#arrowhead)"/>
  <line x1="260" y1="100" x2="280" y2="100" stroke="#2563eb" stroke-width="2" marker-end="url(#arrowhead)"/>
  <line x1="380" y1="100" x2="400" y2="100" stroke="#2563eb" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Icons -->
  <circle cx="90" cy="100" r="20" fill="#2563eb"/>
  <circle cx="210" cy="100" r="20" fill="#8b5cf6"/>
  <circle cx="330" cy="100" r="20" fill="#10b981"/>
  <circle cx="450" cy="100" r="20" fill="#f59e0b"/>
  
  <!-- Arrowhead definition -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" 
            refX="0" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#2563eb"/>
    </marker>
  </defs>
</svg>