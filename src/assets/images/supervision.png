<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="500" height="300" viewBox="0 0 500 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="500" height="300" fill="#f1f5f9"/>
  <rect x="20" y="20" width="460" height="260" rx="10" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  
  <!-- Supervision header -->
  <rect x="30" y="30" width="150" height="20" rx="5" fill="#2563eb"/>
  
  <!-- Charts -->
  <rect x="40" y="70" width="420" height="100" rx="8" fill="#f8fafc"/>
  <rect x="50" y="80" width="400" height="20" rx="4" fill="#2563eb"/>
  <rect x="50" y="105" width="400" height="20" rx="4" fill="#8b5cf6"/>
  
  <!-- Status indicators -->
  <circle cx="100" cy="180" r="10" fill="#10b981"/>
  <circle cx="150" cy="180" r="10" fill="#f59e0b"/>
  <circle cx="200" cy="180" r="10" fill="#ef4444"/>
  <circle cx="250" cy="180" r="10" fill="#10b981"/>
  
  <!-- Legend -->
  <rect x="300" y="170" width="150" height="40" rx="5" fill="#f8fafc"/>
  <rect x="310" y="180" width="10" height="10" rx="2" fill="#10b981"/>
  <rect x="310" y="195" width="10" height="10" rx="2" fill="#f59e0b"/>
  <rect x="360" y="180" width="10" height="10" rx="2" fill="#ef4444"/>
  <rect x="360" y="195" width="10" height="10" rx="2" fill="#2563eb"/>
</svg>